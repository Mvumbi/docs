        "groups": [
          {
            "group": "WordPress",
            "pages": [
              "plugins/wordpress/overview",
              "plugins/wordpress/installation",
              "plugins/wordpress/faq"
            ]
          },
          {
            "group": "Shopify",
            "pages": [
              "plugins/shopify/overview"
            ]
          },
          {
            "group": "PrestaShop",
            "pages": [
              "plugins/prestashop/overview"
            ]
          }
        ]
      }
