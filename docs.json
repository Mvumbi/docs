          {
            "group": "Flutter",
            "pages": [
              "sdks/flutter/installation",
              "sdks/flutter/quickstart",
              "sdks/flutter/reference"
            ]
          },
          {
            "group": "JavaScript",
            "pages": [
              "sdks/js/installation",
              "sdks/js/quickstart",
              "sdks/js/reference"
            ]
          },
          {
            "group": "PHP",
            "pages": [
              "sdks/php/installation",
              "sdks/php/quickstart",
              "sdks/php/reference"
            ]
          }
        ]
      },
      {
